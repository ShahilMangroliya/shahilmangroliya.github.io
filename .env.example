# Firebase Analytics config.
#
# Required for analytics to run. Without these, the app uses the no-op provider
# (analytics disabled) and the build still succeeds.
#
#   Local dev : copy this file to `.env.local` (gitignored) and fill in values.
#   Production: set these as GitHub Actions secrets (same names). The deploy
#               workflow injects them into the build — see
#               .github/workflows/deploy.yml.
#
# The Firebase web apiKey is a PUBLIC identifier, not a secret — it necessarily
# appears in the client bundle. Sourcing from env just keeps config out of the repo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "true" to log every tracked event to the browser console.
# (Automatically on in `npm run dev`.)
VITE_ANALYTICS_DEBUG=
